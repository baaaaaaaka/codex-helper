ARG PYTHON_BASE=python:3.12-slim@sha256:423ed6ab25b1921a477529254bfeeabf5855151dc2c3141699a1bfc852199fbf
FROM ${PYTHON_BASE}

RUN useradd --create-home --uid 10001 --shell /bin/sh tester

WORKDIR /workspace
COPY scripts/cleanup_patched_binaries.py scripts/cleanup_patched_binaries.py
COPY scripts/tests/test_cleanup_patched_binaries.py scripts/tests/test_cleanup_patched_binaries.py
RUN chown -R tester:tester /workspace

ENV PYTHONDONTWRITEBYTECODE=1
ENV PATCH_CLEANUP_CLI_INTEGRATION=1

USER tester
CMD ["python3", "-B", "-m", "unittest", "-v", "scripts/tests/test_cleanup_patched_binaries.py"]
