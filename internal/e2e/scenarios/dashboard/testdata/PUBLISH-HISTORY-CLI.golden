== cli
$ cxp teams chat publish-history s001 --yes
   exit 1
   stderr| Error: publishing complete local history requires --full
$ cxp teams chat publish-history s001 --full
   exit 1
   stderr| Error: publishing local history sends messages to Teams; rerun with --yes
$ cxp teams chat publish-history s999 --full --yes
   exit 1
   stdout| Waiting for the running Teams helper...
   stderr| Error: Teams session not found for "s999"
$ cxp teams chat publish-history s001 --full --yes
   exit 0
   stdout| Waiting for the running Teams helper...
   stdout| Full local Codex history published to the selected Teams chat.
$ cxp teams chat publish-history s001 --full --yes
   exit 0
   stdout| Waiting for the running Teams helper...
   stdout| Full local Codex history is already published to this Teams chat.
$ cxp teams chat publish-history s001 --full --force --yes
   exit 0
   stdout| Waiting for the running Teams helper...
   stdout| Full local Codex history published to the selected Teams chat.
