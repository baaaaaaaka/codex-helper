== cli
$ cxp teams send-file reports/notes.txt
   exit 1
   stderr| Error: choose a target with --session or --chat-id
$ cxp teams send-file reports/notes.txt --chat-id <chat:2>
   exit 1
   stderr| Error: refusing explicit --chat-id without --yes; prefer --session to avoid sending a file to the wrong Teams chat
$ cxp teams send-file <root>/work/elsewhere/local.txt --session s001
   exit 1
   stderr| Error: absolute paths require --allow-local-path (use --allow-local-path for an explicit local upload)
$ cxp teams send-file ../outside.txt --session s001
   exit 1
   stderr| Error: path must stay under Teams outbound root (use --allow-local-path for an explicit local upload)
$ cxp teams send-file reports/notes.txt --session s999
   exit 1
   stdout| Waiting for the running Teams helper...
   stderr| Error: Teams session not found: s999
$ cxp teams send-file reports/notes.txt --session s001
   exit 0
   stdout| Waiting for the running Teams helper...
   stdout| Sent Teams file attachment: notes.txt
   stdout| Target session: s001
$ cxp teams send-file <root>/work/elsewhere/local.txt --allow-local-path --chat-id <chat:2> --yes --message Local notes E2E-SENDFILECLI-file-1
   exit 0
   stdout| Waiting for the running Teams helper...
   stdout| Sent Teams file attachment: local.txt
   stdout| Target session: s001
$ cxp teams send-file reports/notes.txt --session s001
   exit 0
   stdout| The Teams helper is not running. The request is kept and runs when the helper starts (`cxp teams start`, or `cxp teams run --once` to run it once now).
